              "children": [
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "file-icons"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "git-changes"
                  }
                },
                {
                  "id": "review",
                  "type": "block",
                  "content": {
                    "mod": "reviewer"
                  }
                }
              ],
              "active": "agent",
              "size": {
                "px": 532
              },
              "min": 280,
              "max": 900
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-row",
          "type": "row",
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "retro-status"
              },
              "size": {
                "weight": 1
