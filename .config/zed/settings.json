// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_family": ".ZedSans",
  "agent_buffer_font_size": 12.0,
  "agent_ui_font_size": 14.0,
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "zsh",
        "args": []
      }
    },
    "font_weight": 400.0,
    "font_size": 12.0,
    "show_count_badge": true
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "indent_size": 12.0,
    "dock": "right"
  },
  "agent": {
    "default_width": 420.0,
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
      "enable_thinking": true
    },
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "diff_view_style": "unified",
  "git_panel": {
    "default_width": 240.0,
    "dock": "left",
    "tree_view": true
  },
  "project_panel": {
    "sticky_scroll": true,
    "git_status_indicator": false,
    "diagnostic_badges": false,
    "bold_folder_labels": false,
    "indent_size": 12.0,
    "hide_gitignore": false,
    "default_width": 200.0,
    "dock": "left",
    "show_hidden_files": true
  },
  "proxy": "",
  "agent_servers": {
    "gemini": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "favorite_config_option_values": {
        "model": [
          "default"
        ]
      },
      "type": "registry"
    }
  },
  "minimap": {
    "show": "never"
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Catppuccin Mocha"
  },
  "ui_font_size": 15.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
}
