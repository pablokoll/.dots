# tmux plugins (managed by TPM)
.config/tmux/plugins/

# SSH real config (use .ssh/config.example instead)
.ssh/config

# Git config
.gitconfig

# Claude Code settings (contains local MCP paths)
.claude/settings.json
.claude/settings.local.json

# Hyprland/walker backups
.config/hypr/*.backup-*
.config/hypr/*.bak*
.config/walker/*.bak*

# Claude Code runtime state (credentials, sessions, caches, logs)
.claude/.credentials.json
.claude/backups/
.claude/cache/
.claude/daemon/
.claude/debug/
.claude/file-history/
.claude/history.jsonl
.claude/ide/
.claude/image-cache/
.claude/paste-cache/
.claude/projects/
.claude/sessions/
.claude/session-env/
.claude/shell-snapshots/
.claude/statsig/
.claude/stats-cache.json
.claude/todos/
.claude/daemon*
.claude/.last-cleanup
